// Tenon DSL grammar.
//
// This file is intended to be the authoritative grammar for the Tenon DSL.
// The semantic actions build AST types. Later compiler phases lower the AST
// into logical IR, optimized IR, and executable bytecode.
//
// V1 scope:
// - MQTT topic source.
// - Explicit JSON payload decode.
// - Guard expression.
// - Projection expression.
// - Destination dispatch.
//
// Example:
//
// on topic "sensor/+/data"
// decode payload as json into p
// guard p.temp > 30 && topic[1] == "room1"
// emit to raw_kafka, local_log {
//   "topic": topic[1],
//   "payload": p,
//   "first_value": p.values[0],
//   "score": p.temp + 10
// }

grammar;

extern {
    type Error = crate::parser::ParseError;
}

use crate::parser::ast::{
    binary_expr, fold_binary_expr, unary_expr, BinaryOp, DecodeAst, EmitAst, ExprAst,
    ExprKindAst, FieldSegment, FieldSegmentKindAst, LiteralAst, PayloadFormatAst,
    ProjectionItemAst, RuleAst, SourceAst, SourceKindAst, Span, UnaryOp,
};
use crate::parser::literal::{
    parse_float_literal, parse_index_literal, parse_int_literal, unescape_string,
};
use crate::parser::token::validate_ident;

pub Rules: Vec<RuleAst> = {
    <head:Rule> ";" <tail:Rules> => {
        let mut rules = vec![head];
        rules.extend(tail);
        rules
    },
    <rule:Rule> ";" => vec![rule],
    <rule:Rule> => vec![rule],
};

pub Rule: RuleAst = {
    <start:@L> <source:OnClause> <decode:DecodeClause> <guard:GuardClause?> <emit:EmitClause> <end:@R> => {
        RuleAst {
            source,
            decode,
            guard,
            emit,
            span: Span::new(start, end),
        }
    },
};

OnClause: SourceAst = {
    <start:@L> "on" "topic" <topic_filter:StringLiteral> <end:@R> => SourceAst {
        kind: SourceKindAst::Topic {
            filter: topic_filter,
        },
        span: Span::new(start, end),
    },
};

DecodeClause: DecodeAst = {
    <start:@L> "decode" "payload" "as" <format:PayloadFormat> "into" <alias:DecodeAlias> <end:@R> => DecodeAst {
        format,
        alias,
        span: Span::new(start, end),
    },
};

PayloadFormat: PayloadFormatAst = {
    "json" => PayloadFormatAst::Json,
};

GuardClause: ExprAst = {
    "guard" <expr:Expr> => expr,
};

EmitClause: EmitAst = {
    <start:@L> "emit" "to" <destinations:DestinationList> <projection:ProjectionObject> <end:@R> => EmitAst {
        destinations,
        projection,
        span: Span::new(start, end),
    },
};

ProjectionObject: Vec<ProjectionItemAst> = {
    "{" <items:ProjectionItems> "}" => items,
};

ProjectionItems: Vec<ProjectionItemAst> = {
    <head:ProjectionItem> "," <tail:ProjectionItems> => {
        let mut items = vec![head];
        items.extend(tail);
        items
    },
    <item:ProjectionItem> "," => vec![item],
    <item:ProjectionItem> => vec![item],
};

ProjectionItem: ProjectionItemAst = {
    <start:@L> <name:StringLiteral> ":" <expr:Expr> <end:@R> => ProjectionItemAst {
        name,
        expr,
        span: Span::new(start, end),
    },
};

Expr: ExprAst = {
    LogicalOr,
};

LogicalOr: ExprAst = {
    <head:LogicalAnd> <tail:LogicalOrTail*> => fold_binary_expr(head, tail),
};

LogicalOrTail: (BinaryOp, ExprAst) = {
    "||" <right:LogicalAnd> => (BinaryOp::Or, right),
};

LogicalAnd: ExprAst = {
    <head:Equality> <tail:LogicalAndTail*> => fold_binary_expr(head, tail),
};

LogicalAndTail: (BinaryOp, ExprAst) = {
    "&&" <right:Equality> => (BinaryOp::And, right),
};

Equality: ExprAst = {
    <left:Comparison> <tail:EqualityTail?> => match tail {
        Some((op, right)) => binary_expr(op, left, right),
        None => left,
    },
};

EqualityTail: (BinaryOp, ExprAst) = {
    "==" <right:Comparison> => (BinaryOp::Eq, right),
    "!=" <right:Comparison> => (BinaryOp::Ne, right),
};

Comparison: ExprAst = {
    <left:AddSub> <tail:ComparisonTail?> => match tail {
        Some((op, right)) => binary_expr(op, left, right),
        None => left,
    },
};

ComparisonTail: (BinaryOp, ExprAst) = {
    ">" <right:AddSub> => (BinaryOp::Gt, right),
    ">=" <right:AddSub> => (BinaryOp::Ge, right),
    "<" <right:AddSub> => (BinaryOp::Lt, right),
    "<=" <right:AddSub> => (BinaryOp::Le, right),
};

AddSub: ExprAst = {
    <head:MulDivRem> <tail:AddSubTail*> => fold_binary_expr(head, tail),
};

AddSubTail: (BinaryOp, ExprAst) = {
    "+" <right:MulDivRem> => (BinaryOp::Add, right),
    "-" <right:MulDivRem> => (BinaryOp::Sub, right),
};

MulDivRem: ExprAst = {
    <head:Unary> <tail:MulDivRemTail*> => fold_binary_expr(head, tail),
};

MulDivRemTail: (BinaryOp, ExprAst) = {
    "*" <right:Unary> => (BinaryOp::Mul, right),
    "/" <right:Unary> => (BinaryOp::Div, right),
    "%" <right:Unary> => (BinaryOp::Rem, right),
};

Unary: ExprAst = {
    <start:@L> "!" <expr:Unary> => unary_expr(UnaryOp::Not, expr, start),
    <start:@L> "-" <expr:Unary> => unary_expr(UnaryOp::Neg, expr, start),
    Primary,
};

Primary: ExprAst = {
    Literal,
    TopicRef,
    PropertyRef,
    MetadataRef,
    NamedRef,
    <start:@L> "(" <expr:Expr> ")" <end:@R> => expr.with_span(Span::new(start, end)),
};

Literal: ExprAst = {
    <start:@L> <value:StringLiteral> <end:@R> => ExprAst::new(
        ExprKindAst::Literal(LiteralAst::String(value)),
        Span::new(start, end),
    ),
    <start:@L> <value:FloatLiteral> <end:@R> => ExprAst::new(
        ExprKindAst::Literal(LiteralAst::Float(value)),
        Span::new(start, end),
    ),
    <start:@L> <value:IntLiteral> <end:@R> => ExprAst::new(
        ExprKindAst::Literal(LiteralAst::Int(value)),
        Span::new(start, end),
    ),
    <start:@L> "true" <end:@R> => ExprAst::new(
        ExprKindAst::Literal(LiteralAst::Bool(true)),
        Span::new(start, end),
    ),
    <start:@L> "false" <end:@R> => ExprAst::new(
        ExprKindAst::Literal(LiteralAst::Bool(false)),
        Span::new(start, end),
    ),
    <start:@L> "null" <end:@R> => ExprAst::new(
        ExprKindAst::Literal(LiteralAst::Null),
        Span::new(start, end),
    ),
};

TopicRef: ExprAst = {
    <start:@L> "topic" "[" <level:IndexLiteral> "]" <end:@R> => ExprAst::new(
        ExprKindAst::TopicLevel(level),
        Span::new(start, end),
    ),
};

PropertyRef: ExprAst = {
    <start:@L> "properties" "[" <key:StringLiteral> "]" <end:@R> => ExprAst::new(
        ExprKindAst::Property(key),
        Span::new(start, end),
    ),
};

MetadataRef: ExprAst = {
    <start:@L> "metadata" "." <key:Ident> <end:@R> => ExprAst::new(
        ExprKindAst::Metadata(key),
        Span::new(start, end),
    ),
    <start:@L> "metadata" "[" <key:StringLiteral> "]" <end:@R> => ExprAst::new(
        ExprKindAst::Metadata(key),
        Span::new(start, end),
    ),
};

NamedRef: ExprAst = {
    <start:@L> <name:Ident> <path:FieldPath> <end:@R> => ExprAst::new(
        ExprKindAst::VariableField {
            name,
            path,
        },
        Span::new(start, end),
    ),
    <start:@L> <name:Ident> <end:@R> => ExprAst::new(
        ExprKindAst::VariableRoot(name),
        Span::new(start, end),
    ),
};

FieldPath: Vec<FieldSegment> = {
    <segments:FieldSegment+> => segments,
};

FieldSegment: FieldSegment = {
    <start:@L> "." <name:Ident> <end:@R> => FieldSegment::new(
        FieldSegmentKindAst::Name(name),
        Span::new(start, end),
    ),
    <start:@L> "[" <name:StringLiteral> "]" <end:@R> => FieldSegment::new(
        FieldSegmentKindAst::Name(name),
        Span::new(start, end),
    ),
    <start:@L> "[" <index:IndexLiteral> "]" <end:@R> => FieldSegment::new(
        FieldSegmentKindAst::Index(index),
        Span::new(start, end),
    ),
};

DestinationList: Vec<String> = {
    <head:DestinationName> "," <tail:DestinationList> => {
        let mut items = vec![head];
        items.extend(tail);
        items
    },
    <name:DestinationName> "," => vec![name],
    <name:DestinationName> => vec![name],
};

// Sink destination names are matched against configured sink names. They are
// intentionally not checked as identifiers, so `emit to json`, `emit to topic`,
// and `emit to raw-kafka` are valid destination references.
DestinationName: String = {
    Word,
    r"[A-Za-z_][A-Za-z0-9_]*-[A-Za-z0-9_-]*" => <>.to_string(),
    ReservedDestinationName,
};

ReservedDestinationName: String = {
    "on" => "on".to_string(),
    "topic" => "topic".to_string(),
    "decode" => "decode".to_string(),
    "payload" => "payload".to_string(),
    "as" => "as".to_string(),
    "json" => "json".to_string(),
    "into" => "into".to_string(),
    "guard" => "guard".to_string(),
    "emit" => "emit".to_string(),
    "to" => "to".to_string(),
    "true" => "true".to_string(),
    "false" => "false".to_string(),
    "null" => "null".to_string(),
    "properties" => "properties".to_string(),
    "metadata" => "metadata".to_string(),
};

// Reserved keywords:
// on, topic, decode, payload, as, json, into, guard, emit, to,
// true, false, null, properties, metadata, raw_payload.
Ident: String = {
    <start:@L> <raw:Word> <end:@R> =>? Ok(validate_ident(raw.as_str(), Span::new(start, end))?),
};

Word: String = {
    r"[A-Za-z_][A-Za-z0-9_]*" => <>.to_string(),
};

DecodeAlias: String = {
    Ident,
    <start:@L> <raw:ReservedKeyword> <end:@R> =>? Ok(validate_ident(raw.as_str(), Span::new(start, end))?),
};

ReservedKeyword: String = {
    "on" => "on".to_string(),
    "topic" => "topic".to_string(),
    "decode" => "decode".to_string(),
    "payload" => "payload".to_string(),
    "as" => "as".to_string(),
    "json" => "json".to_string(),
    "into" => "into".to_string(),
    "guard" => "guard".to_string(),
    "emit" => "emit".to_string(),
    "to" => "to".to_string(),
    "true" => "true".to_string(),
    "false" => "false".to_string(),
    "null" => "null".to_string(),
    "properties" => "properties".to_string(),
    "metadata" => "metadata".to_string(),
    "raw_payload" => "raw_payload".to_string(),
};

StringLiteral: String = {
    <start:@L> <raw:r#""([^"\\]|\\.)*""#> <end:@R> =>? Ok(unescape_string(raw, Span::new(start, end))?),
};

FloatLiteral: f64 = {
    <start:@L> <raw:r"[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?"> <end:@R> =>? Ok(parse_float_literal(raw, Span::new(start, end))?),
    <start:@L> <raw:r"[0-9]+[eE][+-]?[0-9]+"> <end:@R> =>? Ok(parse_float_literal(raw, Span::new(start, end))?),
};

IntLiteral: i64 = {
    <start:@L> <raw:r"[0-9]+"> <end:@R> =>? Ok(parse_int_literal(raw, Span::new(start, end))?),
};

IndexLiteral: usize = {
    <start:@L> <raw:r"[0-9]+"> <end:@R> =>? Ok(parse_index_literal(raw, Span::new(start, end))?),
};
