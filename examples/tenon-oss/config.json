{
  "rule_json_path": "examples/tenon-oss/rule.json",
  "payload": {
    "format": "json"
  },
  "mqtt": {
    "host": "127.0.0.1",
    "port": 1883,
    "client_count": 1,
    "username": "dev",
    "password": "dev",
    "group_name": "tenon-oss"
  },
  "sinks": {
    "dev_blackhole": {
      "type": "noop"
    },
    "local_log": {
      "type": "log"
    },
    "raw_kafka": {
      "type": "kafka",
      "bootstrap_servers": ["127.0.0.1:9092"],
      "topic": "tenon-output",
      "properties": {
        "queue.buffering.max.messages": "100000",
        "batch.num.messages": "1000",
        "linger.ms": "5",
        "acks": "1"
      }
    },
    "custom_ipc": {
      "type": "ipc",
      "path": "~/.tenon/ipc/custom_ipc.sock",
      "queue_capacity": 4096,
      "batch_max_messages": 64,
      "batch_max_bytes": 1048576,
      "flush_interval_millis": 5
    }
  },
  "metrics": {
    "detailed_latency": false
  }
}
